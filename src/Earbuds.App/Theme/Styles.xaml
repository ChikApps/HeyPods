<!-- Shared look (design: ui.css of the original design source). Colors come from ThemeManager as DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="NumFont">Segoe UI Variable Display, Segoe UI</FontFamily>

  <!-- ===== icons (Fluent-like 1.2 px strokes, from ui.js) ===== -->
  <Geometry x:Key="IcoX">M1,1 L11,11 M11,1 L1,11</Geometry>
  <Geometry x:Key="IcoMin">M0,5 H10</Geometry>
  <Geometry x:Key="IcoGear">M6.6,1.5 H9.4 L9.8,3.3 L11,4 L12.8,3.4 L14.2,5.8 L12.8,7.1 V8.5 L14.2,9.8 L12.8,12.2 L11,11.6 L9.8,12.3 L9.4,14.1 H6.6 L6.2,12.3 L5,11.6 L3.2,12.2 L1.8,9.8 L3.2,8.5 V7.1 L1.8,5.8 L3.2,3.4 L5,4 L6.2,3.3 Z M10.2,8 A2.2,2.2 0 1 1 5.8,8 A2.2,2.2 0 1 1 10.2,8 Z</Geometry>
  <Geometry x:Key="IcoBtOff">M12,13 L27,26 L20,32 V8 L27,14 L12,27 M8,8 L32,32</Geometry>
  <Geometry x:Key="IcoOpen">M3.5,3 H12.5 A1.5,1.5 0 0 1 14,4.5 V11.5 A1.5,1.5 0 0 1 12.5,13 H3.5 A1.5,1.5 0 0 1 2,11.5 V4.5 A1.5,1.5 0 0 1 3.5,3 Z M2,6 H14</Geometry>
  <Geometry x:Key="IcoInfo2">M14.3,8 A6.3,6.3 0 1 1 1.7,8 A6.3,6.3 0 1 1 14.3,8 Z M8,7.2 V11.2 M8,4.6 V5.2</Geometry>
  <Geometry x:Key="IcoExit">M8,2 V8 M4.6,4.2 A5,5 0 1 0 11.4,4.2</Geometry>
  <Geometry x:Key="IcoExt">M5,2 H2 V10 H10 V7 M7,2 H10 V5 M10,2 L5.5,6.5</Geometry>
  <Geometry x:Key="IcoTip">M6,12.5 H10 M6.5,14.5 H9.5 M5.6,10.6 C4.4,9.7 3.6,8.3 3.6,6.7 A4.4,4.4 0 0 1 12.4,6.7 C12.4,8.3 11.6,9.7 10.4,10.6</Geometry>
  <Geometry x:Key="IcoBolt">M6,0 L0,8 H4 L2.6,14 L9.5,5.6 H5.6 L7,0 Z</Geometry>
  <Geometry x:Key="IcoInfoMark">M8,7 V11.5 M8,4.3 V5.3</Geometry>
  <Geometry x:Key="IcoWarnMark">M8,4 V9 M8,11.1 V12.1</Geometry>
  <Geometry x:Key="IcoDown">M10,5 V13 M6.5,9.8 L10,13.3 L13.5,9.8 M6,15 H14</Geometry>
  <Geometry x:Key="IcoCheckSmall">M6,10.2 L8.7,12.9 L14,7.6</Geometry>
  <Geometry x:Key="IcoCheckBig">M12,20.5 L17.5,26 L29,14.5</Geometry>
  <Geometry x:Key="IcoSpeaker">M2.5,6 H5 L8.5,3 V13 L5,10 H2.5 Z M11,5.5 A3.5,3.5 0 0 1 11,10.5</Geometry>
  <Geometry x:Key="IcoWifi">M2,6.5 A9,9 0 0 1 14,6.5 M4.3,9 A5.6,5.6 0 0 1 11.7,9 M6.6,11.4 A2.2,2.2 0 0 1 9.4,11.4</Geometry>

  <Style x:Key="IconPath" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Text}"/>
    <Setter Property="StrokeThickness" Value="1.2"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="SnapsToDevicePixels" Value="False"/>
    <Setter Property="FlowDirection" Value="LeftToRight"/>
  </Style>

  <!-- ===== text ===== -->
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="20"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="Foreground" Value="{DynamicResource Sec}"/>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LineHeight" Value="28"/>
    <Setter Property="Margin" Value="0,4,0,6"/>
  </Style>
  <Style x:Key="SubHeading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,18,0,8"/>
  </Style>

  <!-- ===== buttons ===== -->
  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="14,4,14,5"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Background" Value="{DynamicResource Ctl}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CtlStroke}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bg" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
            <Border x:Name="bottom" CornerRadius="4" BorderBrush="{DynamicResource CtlBottom}" BorderThickness="0,0,0,1"/>
            <Border x:Name="focus" CornerRadius="5" Margin="-3" BorderBrush="{DynamicResource Text}" BorderThickness="2" Visibility="Collapsed"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Foreground" Value="{DynamicResource OnAcc}"/>
    <Setter Property="Background" Value="{DynamicResource Acc}"/>
    <Setter Property="BorderBrush" Value="#14FFFFFF"/>
  </Style>
  <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Foreground" Value="{DynamicResource Low}"/>
  </Style>
  <Style x:Key="IconBtn" TargetType="Button">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" CornerRadius="4" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource Hov}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CaptionBtn" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource Hov}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseCaptionBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource CloseHov}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- text link (popup "not yours?", notices, contact) -->
  <Style x:Key="LinkBtn" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Link}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" BorderThickness="0,0,0,1" BorderBrush="Transparent" Background="Transparent">
            <ContentPresenter x:Name="cp" TextBlock.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Link}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Link}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- whole-card button (About: source code row) -->
  <Style x:Key="CardBtn" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" CornerRadius="6" Padding="16,10" MinHeight="52">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== switch 40×20. RTL: "on" = knob on the LEFT (design §3), so the template is fixed left-to-right ===== -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid FlowDirection="LeftToRight">
            <Border x:Name="focus" CornerRadius="12" Margin="-3" BorderBrush="{DynamicResource Text}" BorderThickness="2" Visibility="Collapsed"/>
            <Border x:Name="track" CornerRadius="10" Background="Transparent" BorderBrush="{DynamicResource TogOff}" BorderThickness="1"/>
            <Ellipse x:Name="knob" Width="10" Height="10" HorizontalAlignment="Right" Margin="0,0,5,0" Fill="{DynamicResource TogOff}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource Acc}"/>
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Acc}"/>
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Left"/>
              <Setter TargetName="knob" Property="Margin" Value="4,0,0,0"/>
              <Setter TargetName="knob" Property="Width" Value="12"/>
              <Setter TargetName="knob" Property="Height" Value="12"/>
              <Setter TargetName="knob" Property="Fill" Value="{DynamicResource OnAcc}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="MinHeight" Value="64"/>
  </Style>

  <!-- small spinning ring ("searching…", "checking…") -->
  <Style x:Key="Spinner" TargetType="Ellipse">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="Stroke" Value="{DynamicResource Sep}"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
  </Style>

  <!-- context menu near the clock -->
  <Style x:Key="TrayMenu" TargetType="ContextMenu">
    <Setter Property="FlowDirection" Value="RightToLeft"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="HasDropShadow" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource Fly}" BorderBrush="{DynamicResource FlyStroke}" BorderThickness="1" CornerRadius="{DynamicResource FlyCorner}" Padding="4" Width="200">
            <StackPanel IsItemsHost="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TrayMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bg" CornerRadius="4" Padding="12,7" Background="Transparent">
            <StackPanel Orientation="Horizontal">
              <ContentPresenter ContentSource="Icon" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource Hov}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
