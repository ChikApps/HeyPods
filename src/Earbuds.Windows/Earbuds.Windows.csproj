<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows adapters (WinRT). Builds on Linux with EnableWindowsTargeting, runs only on Windows 10 2004+. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Earbuds.Windows</RootNamespace>
    <!-- Needed by the source-generated P/Invoke for RegisterHotKey (LibraryImport). No unsafe code is written by hand. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Earbuds.Core\Earbuds.Core.csproj" />
  </ItemGroup>
</Project>
